[
  {
    "id": "d4c0e1f2b3c4d501",
    "type": "comment",
    "name": "Long conversions without a waiting message",
    "info": "For a Node-RED that can be reached from the internet over https (its own address, or a tunnel). The convert node starts the conversion without waiting and gives Converter Studio a **Callback URL**: the address of the http in node below. When the conversion ends, Converter Studio sends one POST there, with the conversion in `msg.payload.conversion`.\n\nThe call is a hint, not the result: the conversion node, with your own API key, gets the real status and the file. The switch node sends only finished conversions to the file node.\n\nChange `https://node-red.example.com` in the convert node to your Node-RED's public address. Converter Studio doesn't call local or private addresses.",
    "x": 230,
    "y": 60,
    "wires": []
  },
  {
    "id": "d4c0e1f2b3c4d502",
    "type": "inject",
    "name": "A long video",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "/data/talk.mp4",
    "payloadType": "str",
    "x": 160,
    "y": 120,
    "wires": [["d4c0e1f2b3c4d503"]]
  },
  {
    "id": "d4c0e1f2b3c4d503",
    "type": "converter-studio-convert",
    "name": "",
    "server": "cf0c5e0a1d2b3c4d",
    "source": "payload",
    "sourceType": "msg",
    "fileName": "filename",
    "fileNameType": "msg",
    "to": "mp3",
    "toType": "str",
    "options": "{}",
    "optionsType": "json",
    "maxCredits": 20,
    "aboveMax": "error",
    "wait": false,
    "output": "buffer",
    "timeout": 600,
    "callbackUrl": "https://node-red.example.com/converter-studio/callback",
    "callbackUrlType": "str",
    "x": 370,
    "y": 120,
    "wires": [["d4c0e1f2b3c4d504"]]
  },
  {
    "id": "d4c0e1f2b3c4d504",
    "type": "debug",
    "name": "Started",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "conversion",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 580,
    "y": 120,
    "wires": []
  },
  {
    "id": "d4c0e1f2b3c4d505",
    "type": "http in",
    "name": "",
    "url": "/converter-studio/callback",
    "method": "post",
    "upload": false,
    "skipBodyParsing": false,
    "swaggerDoc": "",
    "x": 210,
    "y": 220,
    "wires": [["d4c0e1f2b3c4d506", "d4c0e1f2b3c4d507"]]
  },
  {
    "id": "d4c0e1f2b3c4d506",
    "type": "http response",
    "name": "200",
    "statusCode": "200",
    "headers": {},
    "x": 430,
    "y": 180,
    "wires": []
  },
  {
    "id": "d4c0e1f2b3c4d507",
    "type": "converter-studio-conversion",
    "name": "",
    "server": "cf0c5e0a1d2b3c4d",
    "action": "get",
    "conversionId": "payload.conversion.id",
    "conversionIdType": "msg",
    "wait": false,
    "output": "buffer",
    "timeout": 600,
    "x": 440,
    "y": 240,
    "wires": [["d4c0e1f2b3c4d508"]]
  },
  {
    "id": "d4c0e1f2b3c4d508",
    "type": "switch",
    "name": "Done?",
    "property": "conversion.status",
    "propertyType": "msg",
    "rules": [{ "t": "eq", "v": "done", "vt": "str" }, { "t": "else" }],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 640,
    "y": 240,
    "wires": [["d4c0e1f2b3c4d509"], ["d4c0e1f2b3c4d510"]]
  },
  {
    "id": "d4c0e1f2b3c4d509",
    "type": "file",
    "name": "Write the MP3",
    "filename": "\"/data/\" & filename",
    "filenameType": "jsonata",
    "appendNewline": false,
    "createDir": true,
    "overwriteFile": "true",
    "encoding": "none",
    "x": 830,
    "y": 220,
    "wires": [[]]
  },
