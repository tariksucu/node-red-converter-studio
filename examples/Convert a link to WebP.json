[
  {
    "id": "b2c0e1f2b3c4d501",
    "type": "comment",
    "name": "Convert a file at a link and get the result's link",
    "info": "Converter Studio downloads the picture at the link itself, converts it to WebP and the node sends the download link of the result on (it works for 6 hours, for anyone who has it).\n\nThe link can be a direct link to a file, or a Google Drive, Dropbox or OneDrive link that anyone can open. Set **Output** to *The file, as a Buffer* to get the file itself instead.\n\nOpen the **Converter Studio** config node and paste your API key first (https://converter.studio/account#api-keys).",
    "x": 240,
    "y": 60,
    "wires": []
  },
  {
    "id": "b2c0e1f2b3c4d502",
    "type": "inject",
    "name": "A PNG on the web",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "https://nodered.org/about/resources/media/node-red-icon-2.png",
    "payloadType": "str",
    "x": 180,
    "y": 120,
    "wires": [["b2c0e1f2b3c4d503"]]
  },
  {
    "id": "b2c0e1f2b3c4d503",
    "type": "converter-studio-convert",
    "name": "",
    "server": "cf0c5e0a1d2b3c4d",
    "source": "payload",
    "sourceType": "msg",
    "fileName": "filename",
    "fileNameType": "msg",
    "to": "webp",
    "toType": "str",
    "options": "{\"quality\":\"balanced\"}",
    "optionsType": "json",
    "maxCredits": 20,
    "aboveMax": "error",
    "wait": true,
    "output": "url",
    "timeout": 600,
    "callbackUrl": "",
