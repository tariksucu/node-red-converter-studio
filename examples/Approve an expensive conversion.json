[
  {
    "id": "c3c0e1f2b3c4d501",
    "type": "comment",
    "name": "Ask for the price first, convert after an approval",
    "info": "The convert node has **Max credits** 0 and **Above max** set to *Send the quote*: Converter Studio only measures the video and the node sends the quote on, with the price in `msg.conversion.credits`. Nothing is charged yet.\n\nThe change node keeps the conversion's ID in the flow context. Clicking **Approve** sends it to a conversion node set to *Confirm*, which starts the conversion, waits and writes the result.\n\nIn a real flow the approval could come from a dashboard button, an e-mail or a chat message. Quotes wait for 6 hours.",
    "x": 250,
    "y": 60,
    "wires": []
  },
